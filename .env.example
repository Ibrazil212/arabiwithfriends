# GEMINI_API_KEY: Required for Gemini AI API calls (server only, never bundled in the app).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Public URL of the backend used by the native apps (Android/iOS).
# Leave empty for the web version (same origin). Example: https://api.example.com
VITE_API_BASE_URL=""

# ALLOWED_ORIGINS: Comma-separated web origins allowed to call the API (for a separate web front-end).
ALLOWED_ORIGINS=""
